<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; background: linear-gradient(180deg, #f4f7fb 0%, #eef3ff 100%); color: #102033; }
      main { max-width: 1180px; margin: 0 auto; padding: 40px 20px; }
      .card { background: #fff; border-radius: 18px; padding: 24px; box-shadow: 0 10px 30px rgba(16, 32, 51, 0.08); }
      .hero { display: flex; justify-content: space-between; gap: 16px; align-items: center; margin-bottom: 24px; }
      .nav { display: flex; gap: 12px; flex-wrap: wrap; }
      .nav a, button { text-decoration: none; padding: 12px 18px; border-radius: 10px; background: #0f62fe; color: #fff; font-weight: 700; border: 0; cursor: pointer; display: inline-block; }
      .nav a.secondary { background: #e8eef8; color: #102033; }
      .alert { margin-top: 20px; padding: 14px 16px; border-radius: 10px; }
      .alert.error { background: #fff1f0; color: #a61b1b; }
      .selected { margin-bottom: 24px; display: grid; grid-template-columns: 280px 1fr; gap: 16px; align-items: center; }
      .selected img, .thumb { width: 100%; border-radius: 14px; object-fit: cover; }
      .gallery-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin: 24px 0 16px; }
      .gallery-header h2 { margin: 0; }
      .count-pill { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 999px; background: #eef3ff; color: #143d7a; font-weight: 700; font-size: 0.92rem; }
      .gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; }
      .image-card { border: 1px solid #dde6f4; border-radius: 18px; overflow: hidden; background: #fff; display: grid; box-shadow: 0 8px 20px rgba(16, 32, 51, 0.04); transition: transform 0.15s ease, box-shadow 0.15s ease; }
      .image-card:hover { transform: translateY(-2px); box-shadow: 0 14px 28px rgba(16, 32, 51, 0.08); }
      .image-card img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
      .image-card .body { padding: 16px; display: grid; gap: 12px; }
      .image-card .meta { display: grid; gap: 4px; color: #5c6f82; font-size: 0.94rem; }
      .image-card .title-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
      .image-card .badge { padding: 4px 8px; border-radius: 999px; background: #eef8f3; color: #116b3a; font-size: 0.78rem; font-weight: 700; }
      .image-card .badge.selected { background: #eef3ff; color: #143d7a; }
      .image-card form { margin: 0; }
      .image-card button { width: 100%; }
      .is-selected { border-color: #0f62fe; box-shadow: 0 0 0 2px rgba(15, 98, 254, 0.12); }
      .empty { padding: 24px; background: #f6f9fe; border-radius: 14px; color: #5c6f82; }
      .muted { color: #5c6f82; }
      @media (max-width: 760px) {
        .hero, .selected { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="card hero">
        <div>
          <span class="muted">Galeria do Cloudinary</span>
          <h1><%= title %></h1>
          <p class="muted">Escolha uma imagem da biblioteca armazenada. A imagem selecionada aparece destacada abaixo.</p>
        </div>
        <div class="nav">
          <a href="/upload">Voltar ao envio</a>
        </div>
      </section>

      <% if (errorMessage) { %>
        <div class="alert error"><%= errorMessage %></div>
      <% } %>

      <% if (selectedImage) { %>
        <section class="card selected">
          <img src="<%= selectedImage.secureUrl %>" alt="<%= selectedImage.publicId %>" />
          <div>
            <h2>Imagem selecionada</h2>
            <p><strong>ID público:</strong> <%= selectedImage.publicId %></p>
            <p><strong>URL:</strong> <a href="<%= selectedImage.secureUrl %>"><%= selectedImage.secureUrl %></a></p>
            <p><strong>Formato:</strong> <%= selectedImage.format || '-' %></p>
            <p><strong>Bytes:</strong> <%= selectedImage.bytes %></p>
          </div>
        </section>
      <% } %>

      <% if (!images.length) { %>
        <section class="empty">Nenhuma imagem encontrada na galeria ainda. Envie uma imagem primeiro.</section>
      <% } else { %>
        <div class="gallery-header">
          <h2>Imagens armazenadas</h2>
          <span class="count-pill"><%= images.length %> cards</span>
        </div>
        <section class="gallery">
          <% images.forEach((image) => { %>
            <article class="image-card <%= selectedImage && selectedImage.publicId === image.publicId ? 'is-selected' : '' %>">
              <img src="<%= image.secureUrl %>" alt="<%= image.publicId %>" />
              <div class="body">
                <div class="meta">
                  <div class="title-row">
                    <strong><%= image.publicId %></strong>
                    <span class="badge <%= selectedImage && selectedImage.publicId === image.publicId ? 'selected' : '' %>"><%= selectedImage && selectedImage.publicId === image.publicId ? 'Selecionada' : 'Imagem' %></span>
                  </div>
                  <span><%= image.format || '-' %> • <%= image.bytes %> bytes</span>
                </div>
                <form method="post" action="/gallery/select">
                  <input type="hidden" name="publicId" value="<%= image.publicId %>" />
                  <button type="submit"><%= selectedImage && selectedImage.publicId === image.publicId ? 'Imagem escolhida' : 'Escolher imagem' %></button>
                </form>
              </div>
            </article>
          <% }) %>
        </section>
      <% } %>
    </main>
  </body>
</html>